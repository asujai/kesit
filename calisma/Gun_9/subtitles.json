[
  {
    "id": "sub_01",
    "start": 0.2,
    "end": 3.4,
    "text": "Instagram, sosyal kıyaslama...\nSosyal medya gerçeği.",
    "highlight": "sosyal kıyaslama"
  },
  {
    "id": "sub_02",
    "start": 3.6,
    "end": 6.5,
    "text": "Kitap 2024'te çıktığından beri,\nfark ettiğim şey şu oldu:",
    "highlight": "fark ettiğim şey"
  },
  {
    "id": "sub_03",
    "start": 6.7,
    "end": 10.2,
    "text": "Verilen büyük hasarı\ninanılmaz hafife almışım!",
    "highlight": "hafife almışım"
  },
  {
    "id": "sub_04",
    "start": 10.4,
    "end": 13.6,
    "text": "Çünkü yalnızca ruh sağlığına\nodaklanmıştım (ki bu felaket)...",
    "highlight": "ruh sağlığına"
  },
  {
    "id": "sub_05",
    "start": 13.8,
    "end": 17.6,
    "text": "Ama asıl büyük yıkım:\ndikkat becerisinin yok edilmesidir.",
    "highlight": "yok edilmesidir"
  },
  {
    "id": "sub_06",
    "start": 17.8,
    "end": 21.6,
    "text": "Tek seferde birkaç dakika\nbile odaklanamadan...",
    "highlight": "odaklanamadan"
  },
  {
    "id": "sub_07",
    "start": 21.8,
    "end": 24.8,
    "text": "İdeal olarak 10-20 dakika\nkesintisiz dikkat olmadan...",
    "highlight": "kesintisiz dikkat"
  },
  {
    "id": "sub_08",
    "start": 25.0,
    "end": 28.4,
    "text": "İyi bir çalışan olamazsınız,\ndeğer üretemezsiniz.",
    "highlight": "İyi bir çalışan"
  },
  {
    "id": "sub_09",
    "start": 28.6,
    "end": 31.0,
    "text": "İyi bir hayat arkadaşı,\niyi bir eş olamazsınız.",
    "highlight": "iyi bir eş"
  },
  {
    "id": "sub_10",
    "start": 31.2,
    "end": 33.6,
    "text": "Ve hayatta asla\nbaşarılı olamazsınız!",
    "highlight": "başarılı olamazsınız"
  },
  {
    "id": "sub_11",
    "start": 33.8,
    "end": 37.6,
    "text": "İşte o an anladım:\nBu, psikolojinin çok ötesinde.",
    "highlight": "çok ötesinde"
  },
  {
    "id": "sub_12",
    "start": 37.8,
    "end": 42.4,
    "text": "Bu, insan zihnini değiştiriyor:\nhem de küresel ölçekte!",
    "highlight": "küresel ölçekte"
  }
]
