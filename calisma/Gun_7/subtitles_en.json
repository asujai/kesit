[
  {
    "id": "sub_01",
    "start": 0.2,
    "end": 2.5,
    "text": "I just want to show you something:",
    "highlight": "show you something"
  },
  {
    "id": "sub_02",
    "start": 3.2,
    "end": 5.8,
    "text": "This is the psychological power of the device.",
    "highlight": "psychological power"
  },
  {
    "id": "sub_03",
    "start": 7.05,
    "end": 10.0,
    "text": "What if I was sitting here talking to you holding my phone?",
    "highlight": "holding my phone"
  },
  {
    "id": "sub_04",
    "start": 10.8,
    "end": 13.5,
    "text": "It's not buzzing, it's not beeping, no one's calling me.",
    "highlight": "not buzzing"
  },
  {
    "id": "sub_05",
    "start": 13.9,
    "end": 15.8,
    "text": "I'm just holding it.",
    "highlight": "just holding it"
  },
  {
    "id": "sub_06",
    "start": 16.6,
    "end": 20.3,
    "text": "Do you feel like you are the most important thing to me right now?",
    "highlight": "most important thing"
  },
  {
    "id": "sub_07",
    "start": 22.8,
    "end": 24.5,
    "text": "No, you don't.",
    "highlight": "No, you don't"
  },
  {
    "id": "sub_08",
    "start": 24.7,
    "end": 26.5,
    "text": "That's the association.",
    "highlight": "the association"
  },
  {
    "id": "sub_09",
    "start": 27.1,
    "end": 29.5,
    "text": "So when we show up for a meeting,",
    "highlight": "show up for a meeting"
  },
  {
    "id": "sub_10",
    "start": 29.6,
    "end": 32.2,
    "text": "or we sit down for dinner with our families,",
    "highlight": "dinner with our families"
  },
  {
    "id": "sub_11",
    "start": 32.3,
    "end": 34.5,
    "text": "and we put the phone on the table,",
    "highlight": "phone on the table"
  },
  {
    "id": "sub_12",
    "start": 34.8,
    "end": 37.8,
    "text": "it sends a psychological message to everyone sitting there:",
    "highlight": "psychological message"
  },
  {
    "id": "sub_13",
    "start": 38.1,
    "end": 40.6,
    "text": "\"You are not the most important thing to me right now.\"",
    "highlight": "not the most important"
  },
  {
    "id": "sub_14",
    "start": 41.1,
    "end": 42.6,
    "text": "And putting the phone upside down",
    "highlight": "phone upside down"
  },
  {
    "id": "sub_15",
    "start": 42.8,
    "end": 44.4,
    "text": "is NOT more polite!",
    "highlight": "NOT more polite"
  }
]