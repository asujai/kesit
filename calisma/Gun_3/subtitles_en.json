[
  {
    "id": "sub_01",
    "start": 0.15,
    "end": 2.2,
    "text": "We have new modern routines",
    "highlight": "modern routines"
  },
  {
    "id": "sub_02",
    "start": 2.2,
    "end": 4.4,
    "text": "that heavily restrict movement.",
    "highlight": "restrict movement"
  },
  {
    "id": "sub_03",
    "start": 4.4,
    "end": 6.2,
    "text": "Doing everything seated,",
    "highlight": "seated"
  },
  {
    "id": "sub_04",
    "start": 6.2,
    "end": 8.4,
    "text": "doing everything on screens",
    "highlight": "on screens"
  },
  {
    "id": "sub_05",
    "start": 8.4,
    "end": 11.2,
    "text": "with just a finger tap...",
    "highlight": "finger tap"
  },
  {
    "id": "sub_06",
    "start": 11.2,
    "end": 13.1,
    "text": "The most sedentary way",
    "highlight": "sedentary way"
  },
  {
    "id": "sub_07",
    "start": 13.1,
    "end": 15.6,
    "text": "is now preferred everywhere!",
    "highlight": "preferred everywhere"
  },
  {
    "id": "sub_08",
    "start": 15.6,
    "end": 17.5,
    "text": "'Look what you can do",
    "highlight": "what you can do"
  },
  {
    "id": "sub_09",
    "start": 17.5,
    "end": 19.8,
    "text": "with a single click,' they say;",
    "highlight": "single click"
  },
  {
    "id": "sub_10",
    "start": 19.8,
    "end": 21.6,
    "text": "yet we truly lack",
    "highlight": "truly lack"
  },
  {
    "id": "sub_11",
    "start": 21.6,
    "end": 24.3,
    "text": "a biology built for one click!",
    "highlight": "built for one click"
  },
  {
    "id": "sub_12",
    "start": 24.3,
    "end": 26.5,
    "text": "For a single bite of bread,",
    "highlight": "bite of bread"
  },
  {
    "id": "sub_13",
    "start": 26.5,
    "end": 28.7,
    "text": "our ancestors walked miles",
    "highlight": "walked miles"
  },
  {
    "id": "sub_14",
    "start": 28.7,
    "end": 31.0,
    "text": "across vast distances.",
    "highlight": "vast distances"
  },
  {
    "id": "sub_15",
    "start": 31.0,
    "end": 33.4,
    "text": "That our bodies need movement",
    "highlight": "need movement"
  },
  {
    "id": "sub_16",
    "start": 33.4,
    "end": 35.1,
    "text": "is completely obvious;",
    "highlight": "completely obvious"
  },
  {
    "id": "sub_17",
    "start": 35.1,
    "end": 36.3,
    "text": "needs no explanation.",
    "highlight": "no explanation"
  },
  {
    "id": "sub_18",
    "start": 36.3,
    "end": 37.3,
    "text": "What about our minds?",
    "highlight": "our minds?"
  },
  {
    "id": "sub_19",
    "start": 37.3,
    "end": 38.3,
    "text": "What about our emotions?",
    "highlight": "our emotions?"
  },
  {
    "id": "sub_20",
    "start": 38.3,
    "end": 39.4,
    "text": "What about our purpose?",
    "highlight": "our purpose?"
  }
]